@page
@model MinimalHtmxRazor.Pages.IndexModel

@{
    ViewData["Title"] = "Posts";
    var postIdParam = Request.Query["postId"].ToString();
    var hasPostId = int.TryParse(postIdParam, out var parsedPostId) && parsedPostId > 0;
}

<section class="grid">
  <article>
    <h2>Posts</h2>

    <p id="posts-loading" class="muted">Loading posts...</p>

    <div
      hx-get="/htmx/posts"
      hx-trigger="load"
      hx-target="#posts"
      hx-indicator="#posts-loading">
    </div>

    <div id="posts"></div>
  </article>

  <article>
    <h2>Details</h2>

    @if (hasPostId)
    {
        <div id="details"
            hx-get="/htmx/posts/@parsedPostId"
            hx-trigger="load"
            hx-swap="innerHTML">
            <p class="muted">Loading post details...</p>
        </div>
    }
    else
    {
        <div id="details">
            <p class="muted">Select a post to view details.</p>
        </div>
    }

  </article>
</section>
