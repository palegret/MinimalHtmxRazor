@page
@model MinimalHtmxRazor.Pages.IndexModel

@{
    ViewData["Title"] = "Posts";
}

<section class="grid">
  <article>
    <h2>Posts</h2>

    <p id="posts-loading" class="muted">Loading posts...</p>

    <div
      hx-get="/htmx/posts"
      hx-trigger="load"
      hx-target="#posts"
      hx-indicator="#posts-loading">
    </div>

    <div id="posts"></div>
  </article>

  <article>
    <h2>Details</h2>
    <div id="details">
      <p class="muted">Select a post to view details.</p>
    </div>
  </article>
</section>
